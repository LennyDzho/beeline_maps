AUTH_BOOTSTRAP_EMAIL=admin@example.com
AUTH_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
AUTH_BOOTSTRAP_NAME=Администратор
TWO_GIS_API_KEY=replace-with-a-2gis-api-key
TWO_GIS_MAPGL_KEY=replace-with-a-domain-restricted-mapgl-key
# Optional raster tile service; uses OSM Standard by default. Must include {z}/{x}/{y}.
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# Optional dedicated OSRM servers. Empty values use public demo servers (no production SLA).
# Each server must be prepared with the matching driving/foot profile.
OSRM_BASE_URL=
OSRM_WALKING_BASE_URL=
# Required for cycling with OSRM: server data must be prepared with bicycle.lua.
# No fallback to the car/foot graph. Alternatively select the 2GIS matrix.
OSRM_CYCLING_BASE_URL=
# Private OR-Tools service; HTTPS and a token are required outside localhost.
OPTIMIZER_SERVICE_URL=http://127.0.0.1:8765
OPTIMIZER_SERVICE_TOKEN=
PLANNING_DEPOT_LAT=55.7558
PLANNING_DEPOT_LON=37.6176
